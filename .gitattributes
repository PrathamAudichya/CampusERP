# ==============================================================================
# Campus ERP — Git Attributes & Line Ending Normalization
# ==============================================================================

# Default behavior: auto-normalize text files to LF in repository
* text=auto eol=lf

# Explicit LF normalization for cross-platform source files
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Windows command and batch scripts require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets (prevent corruption from line-ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.war binary
*.zip binary
*.tar.gz binary
*.db binary
*.sqlite binary
